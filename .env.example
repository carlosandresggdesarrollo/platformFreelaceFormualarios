# Copia este archivo a ".env" y pon valores propios. ".env" nunca se sube a git.

# Contraseña root de MariaDB (solo para administrar la base, la aplicacion NO la usa).
DB_ROOT_PASS=cambia-esta-contrasena-root

# Usuario con permisos minimos que usa la aplicacion PHP.
DB_NAME=formularios
DB_USER=formularios_app
DB_PASS=cambia-esta-contrasena-app

# Secreto para firmar los tokens JWT (minimo 32 caracteres).
# Generalo con:  openssl rand -base64 48
JWT_SECRET=

# API key de DeepSeek para "Crear con IA" (opcional).
DEEPSEEK_API_KEY=

# URL publica del frontend, sin "/" final. Se usa en los enlaces de los correos.
APP_URL=http://localhost:3039/formularios

# Servidor de correo para confirmar cuentas y recuperar contraseñas.
# Si SMTP_HOST queda vacio se usa la fila de la tabla servidorCorreo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
