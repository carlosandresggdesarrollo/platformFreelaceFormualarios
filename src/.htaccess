# Permitir subidas grandes (películas, audio, PDF): sin límite de tamaño a nivel de Apache.
# El tope real lo definen PHP (post_max_size / upload_max_filesize = 8G).
LimitRequestBody 0

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No tocar las peticiones al backend PHP
  RewriteRule ^formularios/administrador/ - [L]

  # SPA: rutas bajo /formularios/ van a /formularios/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^formularios/(.*)$ formularios/index.html [QSA,L]

  # Fallback general para otras rutas
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Configurar tipos MIME correctos
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# Habilitar compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/xml application/xml
</IfModule>

# Configurar cache para assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
